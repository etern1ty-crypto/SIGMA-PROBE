# The CLI does not load .env files automatically. Export variables explicitly.
# Never commit a real HMAC key. No API keys or network connections are required.
SIGMA_PROBE_CONFIG=config.example.toml
SIGMA_PROBE_SITE=demo-site
SIGMA_PROBE_OUTPUT_DIR=reports
SIGMA_PROBE_LOG_LEVEL=INFO
# Optional stable pseudonyms: generate and store a random >=32-byte secret.
# If omitted, --anonymize-ips uses a new ephemeral key on every run.
SIGMA_PROBE_HMAC_KEY=
